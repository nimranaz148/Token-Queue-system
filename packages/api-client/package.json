{
  "name": "@clinic/api-client",
  "version": "0.1.0",
  "description": "Generated TypeScript client from FastAPI OpenAPI contract",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "npx openapi-typescript http://localhost:8000/openapi.json -o src/generated/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3"
  }
}
